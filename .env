# Local development environment
NODE_ENV=development
PORT=3000

# Database (local PostgreSQL)
DATABASE_URL=postgresql://hamza-nsd@localhost:5432/healthDemoDB?schema=public
SHADOW_DATABASE_URL=postgresql://hamza-nsd@localhost:5432/healthcare_shadow?schema=public

# Redis / BullMQ (disabled locally until Redis is installed; docker-compose enables it)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
